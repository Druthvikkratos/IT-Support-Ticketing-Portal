// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  employee
}

enum Priority {
  low
  medium
  high
}

enum TicketStatus {
  raised
  pending
  in_progress
  solved
  closed
}

enum FieldType {
  text
  textarea
  number
  date
  dropdown
  radio
  checkbox
  phone
  email
  file
}

enum NotificationType {
  ticket_raised
  status_changed
  new_message
  ticket_closed
  bulk_upload_result
}

model User {
  id           String   @id @default(uuid())
  role         Role
  employeeCode String?  @unique @map("employee_code") @db.VarChar(4)
  name         String
  email        String   @unique
  password     String   @map("password")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  createdById         String?               @map("created_by_id")
  createdBy           User?                 @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers        User[]                @relation("UserCreatedBy")
  statusChanges       TicketStatusHistory[] @relation("StatusChangedBy")
  uploadedAttachments TicketAttachment[]

  deletedAt    DateTime? @map("deleted_at")
  deletedById  String?   @map("deleted_by_id")
  deletedBy    User?     @relation("UserDeletedBy", fields: [deletedById], references: [id])
  deletedUsers User[]    @relation("UserDeletedBy")

  ticketsRaised      Ticket[]            @relation("RaisedBy")
  ticketMessages     TicketMessage[]
  ticketMessageReads TicketMessageRead[]
  notifications      Notification[]

  @@map("users")
}

model IssueType {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt
  tickets   Ticket[]

  @@map("issue_type")
}

model FormField {
  id           Int       @id @default(autoincrement())
  label        String
  fieldType    FieldType @map("field_type")
  options      Json?
  fileConfig   Json?     @map("file_config")
  isRequired   Boolean   @default(false) @map("is_requried")
  displayOrder Int       @default(0) @map("display_order")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("form_fields")
}

model Ticket {
  id                String       @id @default(uuid())
  ticketNumber      String       @unique @map("ticket_number")
  title             String
  description       String       @db.Text
  issueTypeId       Int
  issueType         IssueType    @relation(fields: [issueTypeId], references: [id])
  priority          Priority
  status            TicketStatus @default(raised)
  phoneNumber       String       @map("phone_number")
  customFieldValues Json?        @map("custom_field_values")

  raisedById    String
  rasiedBy      User                  @relation("RaisedBy", fields: [raisedById], references: [id])
  statusHistory TicketStatusHistory[]
  attachments   TicketAttachment[]

  isDeleted          Boolean             @default(false) @map("is_deleted")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  closedAt           DateTime?           @map("closed_at")
  ticketMessages     TicketMessage[]
  ticketMessageReads TicketMessageRead[]

  @@map("tickets")
}

model TicketCounter {
  id         Int @id @default(1)
  lastNumber Int @default(0)

  @@map("ticket_counter")
}

model TicketStatusHistory {
  id          String        @id @default(uuid())
  ticketId    String        @map("ticket_id")
  ticket      Ticket        @relation(fields: [ticketId], references: [id])
  oldStatus   TicketStatus? @map("old_status")
  newStatus   TicketStatus  @map("new_status")
  changedById String        @map("changed_by_id")
  changedBy   User          @relation("StatusChangedBy", fields: [changedById], references: [id])
  changedAt   DateTime      @default(now()) @map("changed_at")

  @@map("ticket_status_history")
}

model TicketAttachment {
  id             String          @id @default(uuid())
  ticketId       String          @map("ticket_id")
  ticket         Ticket          @relation(fields: [ticketId], references: [id])
  fieldId        Int?            @map("field_int")
  originalName   String          @map("original_name")
  filePath       String          @map("file_path")
  fileSize       Int             @map("file_size")
  detectedMime   String          @map("detected_mime")
  uploadedById   String
  uploadedBy     User            @relation(fields: [uploadedById], references: [id])
  uploadedAt     DateTime        @default(now()) @map("uploaded_at")
  ticketMessages TicketMessage[]

  @@map("ticket_attachements")
}

model TicketMessage {
  id           String            @id @default(uuid())
  ticketId     String            @map("ticket_id")
  ticket       Ticket            @relation(fields: [ticketId], references: [id])
  senderId     String            @map("sender_id")
  sender       User              @relation(fields: [senderId], references: [id])
  message      String?           @db.Text
  attachmentId String?
  attachment   TicketAttachment? @relation(fields: [attachmentId], references: [id])
  createdAt    DateTime          @default(now()) @map("created_at")

  @@map("ticket_messages")
}

model TicketMessageRead {
  id         String   @id @default(uuid())
  ticketId   String   @map("ticket_id")
  ticket     Ticket   @relation(fields: [ticketId], references: [id])
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id])
  lastReadAt DateTime @default(now()) @map("last_read_at")

  @@unique([ticketId, userId])
  @@map("ticket_message_reads")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType @map("notification_type")
  message   String
  ticketId  String?          @map("ticket_id")
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  @@map("notifications")
}
